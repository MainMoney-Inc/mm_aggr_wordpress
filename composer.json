{
  "name": "mainmoney/mm-aggr-wordpress",
  "description": "WordPress plugin for MainMoney aggregator payments",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/MainMoney-Inc/mm_aggr_wordpress",
  "authors": [
    {
      "name": "MainMoney SARL"
    }
  ],
  "keywords": [
    "mainmoney",
    "payments",
    "wordpress",
    "wordpress-plugin"
  ],
  "support": {
    "issues": "https://github.com/MainMoney-Inc/mm_aggr_wordpress/issues",
    "source": "https://github.com/MainMoney-Inc/mm_aggr_wordpress"
  },
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "mainmoney/mm-aggr-php-sdk": "^0.1.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "MainMoney\\WordPressPlugin\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MainMoney\\WordPressPlugin\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse"
  },
  "config": {
    "sort-packages": true
  }
}
